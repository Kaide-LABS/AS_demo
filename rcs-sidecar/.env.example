# ─── Gemini / Google GenAI ────────────────────────────────────────────────
# Default mode: API key (no gcloud required). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key

# Vertex mode (opt-in): set USE_VERTEXAI=1 when running demo/run_demo.sh.
# Requires `gcloud auth application-default login` and these three vars:
# GOOGLE_GENAI_USE_VERTEXAI=True
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global

# ─── Auth (JWT) ────────────────────────────────────────────────────────────
# Required. Shared secret used by auth.verify_token.
RCS_JWT_SECRET=change-me-in-prod
RCS_JWT_ALGORITHM=HS256

# ─── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated extra origins beyond localhost defaults.
CORS_ORIGINS=

# ─── Redis (optional — enables SSE, cost tracking, copilot state) ─────────
# Leave unset to run without Redis. If set but unreachable, healthz reports "degraded".
REDIS_URL=

# ─── Connectors (optional) ─────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
